OPENAI_API_KEY=

# supabase.com のプロジェクト作成後、Project Settings > API から取得する。
# どちらも公開されて良い値(実際のアクセス制御はsupabase/schema.sqlのRLSが担う)。
# service_role キーは絶対にここへ書かない(サーバーでも使わない)。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DBなし体験版(/demo)の合言葉ログイン。上の NEXT_PUBLIC_SUPABASE_* を空にすると「DBなしデモモード」になり、
# /demo が合言葉ログインの内側で動く(本番アプリは Supabase 認証が守るので、下の2つは使われない)。
# DEMO_PASSWORD_HASH: `npx tsx scripts/hash-password.ts` で生成した scrypt:... の1行(合言葉そのものは保存しない)。
# DEMO_SESSION_SECRET: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` の出力。
DEMO_PASSWORD_HASH=
DEMO_SESSION_SECRET=
